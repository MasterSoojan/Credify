# Basic browser checks work without any credentials. Keep services off while hosted Supabase is paused.
SITE_URL=http://localhost:3000
CREDIFY_AUTH_ENABLED=false
CREDIFY_AI_ENABLED=false
CREDIFY_REGISTRY_ENABLED=false

# Use local Supabase values during development. Never put a service-role key in a NEXT_PUBLIC variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Generate a unique server-only secret, e.g. `openssl rand -base64 48`. Required to enable accounts.
AUTH_COOKIE_SECRET=

# Optional AI. Requires enabled accounts, a valid model, and a shared Redis limiter in every environment.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CREDIFY_AI_DAILY_LIMIT=100

# Required for all production account mutations and for AI calls in every environment.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
