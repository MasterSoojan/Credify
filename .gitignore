# Dependencies and package-manager working files (keep package-lock.json)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js / TypeScript generated files
/.next/
/out/
/next-env.d.ts
*.tsbuildinfo

# Build and tool caches
/build/
/dist/
/.cache/
/.turbo/

# Test output (keep test source and documentation screenshots)
/coverage/
/.nyc_output/
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# Environment and private credentials; only the sanitized root example is committed
.env*
!/.env.example
*.pem
*.key
*.p12
*.pfx

# Local deployment and Supabase state (keep config, migrations, and email templates)
/.vercel/
/supabase/.temp/
/supabase/.branches/

# Runtime and package-manager logs
*.log
*.log.*

# Local experiments and private review notes
/scratch/
/bugs_and_errors.txt
/for_knowledge/

# OS/editor temporary files
.DS_Store
Thumbs.db
*.swp
*.swo
*~
